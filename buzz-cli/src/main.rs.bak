mod providers;
mod tui;

use std::env;
use std::error::Error;
use std::io::Write;
use clap::Parser;
use indicatif::ProgressBar;
use colored::Colorize;

use providers::{AnthropicProvider, GeminiProvider, GroqProvider, HuggingFaceProvider};

#[derive(Parser)]
#[command(
    name = "buzz",
    version = "0.1.0",
    about = "Multi-provider AI CLI with privacy-first local routing"
)]
struct Cli {
    #[arg(required_unless_present_any = ["chat", "tui", "setup"])]
    prompt: Option<String>,

    #[arg(long, short)]
    chat: bool,

    #[arg(long)]
    tui: bool,

    #[arg(long)]
    setup: bool,

    #[arg(short, long)]
    provider: Option<String>,
}

fn main() -> Result<(), Box<dyn Error>> {
    let cli = Cli::parse();

    if cli.setup {
        return run_setup_wizard();
    }

    if cli.tui || cli.chat {
        let provider = select_provider_name(&cli.provider);
        return run_tui_mode(&provider);
    }

    if let Some(prompt) = cli.prompt {
        return run_cli_mode(&prompt, &cli.provider);
    }

    print_banner();
    Ok(())
}

fn print_banner() {
    println!("\n{}", "=".repeat(50));
    println!("  Buzz CLI v0.1.0");
    println!("{}", "=".repeat(50));
    println!("\n  Local-first AI routing with privacy protection\n");
    println!("  Usage:");
    println!("    buzz \"your prompt\"        Send prompt to AI");
    println!("    buzz --chat                Full-screen TUI chat");
    println!("    buzz --setup               Run setup wizard");
    println!("    buzz --help                Show help\n");
}

fn run_setup_wizard() -> Result<(), Box<dyn Error>> {
    println!("\n{}", "=".repeat(50));
    println!("  Welcome to Buzz CLI Setup");
    println!("{}", "=".repeat(50));

    let mut config = Config::default();

    print!("\nGroq API key (Enter to skip): ");
    std::io::stdout().flush()?;
    let mut input = String::new();
    std::io::stdin().read_line(&mut input)?;
    config.groq_api_key = input.trim().to_string();

    print!("Anthropic API key (Enter to skip): ");
    input.clear();
    std::io::stdout().flush()?;
    std::io::stdin().read_line(&mut input)?;
    config.anthropic_api_key = input.trim().to_string();

    print!("Gemini API key (Enter to skip): ");
    input.clear();
    std::io::stdout().flush()?;
    std::io::stdin().read_line(&mut input)?;
    config.gemini_api_key = input.trim().to_string();

    print!("HuggingFace API key (Enter to skip): ");
    input.clear();
    std::io::stdout().flush()?;
    std::io::stdin().read_line(&mut input)?;
    config.hf_api_key = input.trim().to_string();

    print!("\nDaily budget USD (default $5.00): ");
    input.clear();
    std::io::stdout().flush()?;
    std::io::stdin().read_line(&mut input)?;
    config.daily_budget_usd = input.trim().parse().unwrap_or(5.0);

    save_config(&config)?;

    println!("\n{}", "=".repeat(50));
    println!("  Setup Complete");
    println!("{}", "=".repeat(50));
    println!("\n  Config saved to ~/.buzz/config.toml");
    println!("  Run: buzz --chat\n");

    Ok(())
}

fn run_cli_mode(prompt: &str, provider_override: &Option<String>) -> Result<(), Box<dyn Error>> {
    let rt = tokio::runtime::Runtime::new()?;
    rt.block_on(run_cli_async(prompt, provider_override))
}

async fn run_cli_async(prompt: &str, provider_override: &Option<String>) -> Result<(), Box<dyn Error>> {
    let provider = select_provider_name(provider_override);

    let bar = "-".repeat(50);
    println!("\n{} Using {} Provider", ">>", provider.to_uppercase());
    println!("{}", bar);

    let pb = ProgressBar::new_spinner();
    pb.enable_steady_tick(std::time::Duration::from_millis(100));
    pb.set_message("Thinking...");

    let result = execute_provider(&provider, prompt).await;

    pb.finish_and_clear();

    match result {
        Ok((content, tokens, cost)) => {
            println!("{}\n", content);
            println!("{}", bar);
            println!("  Tokens: {} | Cost: ${:.6}", tokens, cost);
        }
        Err(e) => {
            eprintln!("\nError: {}", e);
            std::process::exit(1);
        }
    }

    println!();
    Ok(())
}

fn run_tui_mode(default_provider: &str) -> Result<(), Box<dyn Error>> {
    use crossterm::{
        event::{DisableMouseCapture, EnableMouseCapture},
        execute,
        terminal::{disable_raw_mode, enable_raw_mode, EnterAlternateScreen, LeaveAlternateScreen},
    };
    use ratatui::backend::CrosstermBackend;
    use ratatui::Terminal;
    use tui::event::{poll_event, InputEvent};

    enable_raw_mode()?;
    let mut stdout = std::io::stdout();
    execute!(stdout, EnterAlternateScreen, EnableMouseCapture)?;
    let backend = CrosstermBackend::new(stdout);
    let mut terminal = Terminal::new(backend)?;

    let mut app = tui::app::App::new(5.0);
    app.provider_name = default_provider.to_string();
    let mut show_help = false;

    // Add system message
    app.add_message("system", "Providers initialized", false);

    let rt = tokio::runtime::Runtime::new()?;

    loop {
        terminal.draw(|frame| {
            tui::ui::render(frame, &app);
            if show_help {
                let area = frame.size();
                let [cx, cy] = tui::ui::center(area, 50, 10);
                tui::ui::render_help_popup(frame, ratatui::layout::Rect::new(cx, cy, 50, 10));
            }
        })?;

        if let Some(event) = poll_event(100)? {
            match event {
                InputEvent::Char(ch) => app.push_char(ch),
                InputEvent::Backspace => app.backspace(),
                InputEvent::Delete => app.delete(),
                InputEvent::CursorLeft => app.move_cursor_left(),
                InputEvent::CursorRight => app.move_cursor_right(),
                InputEvent::Submit(_) => {
                    let prompt = app.input_buffer.clone();
                    if prompt.is_empty() { continue; }

                    // Handle commands
                    if prompt.starts_with('/') {
                        let cmd = prompt.trim();
                        if cmd == "/quit" || cmd == "/exit" {
                            app.quit();
                            continue;
                        }
                        if cmd == "/help" {
                            show_help = !show_help;
                            app.input_buffer.clear();
                            app.cursor_position = 0;
                            continue;
                        }
                        if cmd.starts_with("/provider ") {
                            let parts: Vec<&str> = cmd.split_whitespace().collect();
                            if parts.len() > 1 {
                                app.provider_name = parts[1].to_string();
                                app.add_message("system", &format!("Switched to: {}", parts[1]), false);
                            }
                            app.input_buffer.clear();
                            app.cursor_position = 0;
                            continue;
                        }
                        if cmd == "/reset" {
                            app.messages.clear();
                            app.current_spend_usd = 0.0;
                            app.add_message("system", "Session reset", false);
                            app.input_buffer.clear();
                            app.cursor_position = 0;
                            continue;
                        }
                        app.input_buffer.clear();
                        app.cursor_position = 0;
                        continue;
                    }

                    // Add user message
                    app.add_message(&app.provider_name.clone(), &prompt, true);

                    // Show thinking indicator
                    app.add_message(&app.provider_name.clone(), "Generating...", false);
                    let msg_idx = app.messages.len() - 1;

                    // Execute real provider call
                    let provider = app.provider_name.clone();
                    let result = rt.block_on(execute_provider(&provider, &prompt));

                    match result {
                        Ok((content, tokens, cost)) => {
                            app.messages[msg_idx].content = content;
                            app.update_spend(cost);
                        }
                        Err(e) => {
                            app.messages[msg_idx].content = format!("Error: {}", e);
                        }
                    }

                    app.input_buffer.clear();
                    app.cursor_position = 0;
                },
                InputEvent::Quit => app.quit(),
                _ => {}
            }
        }

        if !app.is_running {
            break;
        }
    }

    terminal.clear()?;
    disable_raw_mode()?;
    execute!(terminal.backend_mut(), LeaveAlternateScreen, DisableMouseCapture)?;
    terminal.show_cursor()?;

    println!("Goodbye!");
    Ok(())
}

async fn execute_provider(provider: &str, prompt: &str) -> Result<(String, u64, f64), Box<dyn Error + Send + Sync>> {
    match provider.to_lowercase().as_str() {
        "groq" => {
            let key = env::var("GROQ_API_KEY")
                .or_else(|_| Ok::<String, std::env::VarError>(get_config().map(|c| c.groq_api_key).unwrap_or_default()))
                .unwrap_or_default();
            if key.is_empty() {
                return Err("No Groq API key. Set GROQ_API_KEY or run: buzz --setup".into());
            }
            GroqProvider::new(key, None).generate(prompt).await
        }
        "anthropic" => {
            let key = env::var("ANTHROPIC_API_KEY")
                .or_else(|_| Ok::<String, std::env::VarError>(get_config().map(|c| c.anthropic_api_key).unwrap_or_default()))
                .unwrap_or_default();
            if key.is_empty() {
                return Err("No Anthropic API key. Set ANTHROPIC_API_KEY or run: buzz --setup".into());
            }
            AnthropicProvider::new(key, None).generate(prompt).await
        }
        "gemini" => {
            let key = env::var("GEMINI_API_KEY")
                .or_else(|_| Ok::<String, std::env::VarError>(get_config().map(|c| c.gemini_api_key).unwrap_or_default()))
                .unwrap_or_default();
            if key.is_empty() {
                return Err("No Gemini API key. Set GEMINI_API_KEY or run: buzz --setup".into());
            }
            GeminiProvider::new(key, None).generate(prompt).await
        }
        "huggingface" | "hf" => {
            let key = env::var("HF_API_KEY")
                .or_else(|_| env::var("HUGGINGFACE_API_KEY"))
                .or_else(|_| Ok::<String, std::env::VarError>(get_config().map(|c| c.hf_api_key).unwrap_or_default()))
                .unwrap_or_default();
            if key.is_empty() {
                return Err("No HuggingFace API key. Set HF_API_KEY or run: buzz --setup".into());
            }
            HuggingFaceProvider::new(key, None).generate(prompt).await
        }
        _ => Err(format!("Unknown provider: {}. Use groq|anthropic|gemini|huggingface", provider).into())
    }
}

fn select_provider_name(override_opt: &Option<String>) -> String {
    override_opt.as_ref()
        .map(|s| s.to_lowercase())
        .or_else(|| env::var("PROVIDER").ok())
        .unwrap_or_else(|| "groq".to_string())
}

#[derive(Default)]
struct Config {
    groq_api_key: String,
    anthropic_api_key: String,
    gemini_api_key: String,
    hf_api_key: String,
    daily_budget_usd: f64,
}

fn get_config() -> Result<Config, Box<dyn Error>> {
    let home = std::env::var("HOME").unwrap_or_else(|_| ".".to_string());
    let path = format!("{}/.buzz/config.toml", home);
    let content = std::fs::read_to_string(&path).unwrap_or_default();

    let mut config = Config::default();
    for line in content.lines() {
        if let Some((key, val)) = line.split_once('=') {
            match key.trim() {
                "groq_api_key" => config.groq_api_key = val.trim().trim_matches('"').to_string(),
                "anthropic_api_key" => config.anthropic_api_key = val.trim().trim_matches('"').to_string(),
                "gemini_api_key" => config.gemini_api_key = val.trim().trim_matches('"').to_string(),
                "hf_api_key" => config.hf_api_key = val.trim().trim_matches('"').to_string(),
                "huggingface_api_key" => config.hf_api_key = val.trim().trim_matches('"').to_string(),
                "daily_budget_usd" => config.daily_budget_usd = val.trim().parse().unwrap_or(5.0),
                _ => {}
            }
        }
    }

    Ok(config)
}

fn save_config(config: &Config) -> Result<(), Box<dyn Error>> {
    let home = std::env::var("HOME").unwrap_or_else(|_| ".".to_string());
    let path = format!("{}/.buzz/config.toml", home);

    if let Some(parent) = std::path::Path::new(&path).parent() {
        std::fs::create_dir_all(parent)?;
    }

    let content = format!(
        "# Buzz CLI Configuration\n\
        groq_api_key = \"{}\"\n\
        anthropic_api_key = \"{}\"\n\
        gemini_api_key = \"{}\"\n\
        hf_api_key = \"{}\"\n\
        daily_budget_usd = {}\n",
        config.groq_api_key,
        config.anthropic_api_key,
        config.gemini_api_key,
        config.hf_api_key,
        config.daily_budget_usd
    );

    std::fs::write(&path, &content)?;

    #[cfg(unix)]
    {
        use std::os::unix::fs::PermissionsExt;
        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600))?;
    }

    Ok(())
}
